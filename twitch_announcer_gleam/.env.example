# Copy to .env and fill in real values. Never commit .env (secrets live there).
# STAGE: DEV runs once with timing logs, PROD loops forever with DB writes.
STAGE=DEV
POSTGRES_CONNECTION_STRING=postgres://postgres:postgres@localhost:5432/postgres
TWITCH_APP_ID=
TWITCH_APP_SECRET=
OFFLINE_GRACE_TIME=1800
# POLL_INTERVAL_S: PROD sleep between cycles; 10..3600, default 60, restart to apply.
POLL_INTERVAL_S=60
