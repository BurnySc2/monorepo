{
    "name": "@repo/sc2-utils",
    "version": "0.0.0",
    "type": "module",
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*",
        "src",
        "!src/**/*.test.*",
        "!src/**/*.spec.*"
    ],
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "svelte-package --input=src",
        "check": "tsc --noEmit",
        "test": "vitest run",
        "test:unit": "vitest run",
        "test:integration": "echo 'No integration tests'"
    },
    "devDependencies": {
        "@sveltejs/kit": "^2.0.0",
        "svelte": "^5.0.0",
        "svelte-check": "^4.0.0",
        "typescript": "^5.0.0",
        "vitest": "^4.1.0"
    }
}
