POSTGRES_CONNECTION_STRING=postgresql://postgres:password@domain.com/litestar_server
BACKEND_DOMAIN=backend-domain.com
BACKEND_SERVER_URL=https://backend-domain.com
BACKEND_WS_SERVER_URL=wss:backend-domain.com

# TTS
TIKTOK_SESSION_ID=session-id-obtained-by-tiktok-login-cookie

# Login and audiobook
# https://github.com/settings/developers
GITHUB_APP_CLIENT_ID=your-github-app-client-id
GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret

# https://dev.twitch.tv/console
TWITCH_APP_CLIENT_ID=your-twitch-app-client-id
TWITCH_APP_CLIENT_SECRET=your-twitch-app-client-secret

# https://console.cloud.google.com/apis/credentials
GOOGLE_APP_CLIENT_ID=your-google-app-client-id
GOOGLE_APP_CLIENT_SECRET=your-google-app-client-secret

# https://developers.facebook.com/apps
FACEBOOK_APP_CLIENT_ID=your-facebook-app-client-id
FACEBOOK_APP_CLIENT_SECRET=your-facebook-app-client-secret

# AWS S3 "open source clone"
RUSTFS_AUDIOBOOK_BUCKET=rustfs-audiobook-bucket
RUSTFS_S3_URL=http://localhost:9000
RUSTFS_ADMIN_URL=http://localhost:9001
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# Audiobook converter
AUDIOBOOK_CONVERT_ESTIMATE_FACTOR=0.3
AUDIOBOOK_MAX_CONCURRENT_CONVERSIONS=1

# Telegram browser
ALLOWED_TWITCH_USERS_FOR_TELEGRAM_BROWSER=some;user;and;another
RUSTFS_TELEGRAM_FILES_BUCKET=telegram-files-bucket

# Frontend login redirect url
FRONTEND_URL=http://localhost:5173

STAGE=dev
