POSTGRES_CONNECTION_STRING=postgresql://root:root@0.0.0.0:5432/litestar_server

# For tiktok tts
TIKTOK_SESSION_ID=14b4191be711a8831547ec69d204d136

# AWS S3 "open source clone"
MINIO_AUDIOBOOK_BUCKET=audiobooks
MINIO_AUDIOBOOK_MAX_SIZE_MB=100000
# Needs to be generated at http://minioadmin.localhost with login 'root' password 'rootroot'
# Don't use internal minio url or it will fail half the time
MINIO_URL=http://0.0.0.0:9000
MINIO_ACCESS_TOKEN=root
MINIO_SECRET_KEY=rootroot

# Audiobook converter
AUDIOBOOK_CONVERT_ESTIMATE_FACTOR=0.3
AUDIOBOOK_MAX_CONCURRENT_CONVERSIONS=1

# Telegram browser
ALLOWED_TWITCH_USERS_FOR_TELEGRAM_BROWSER=burnysc2 twitch;some_other_user
MINIO_TELEGRAM_FILES_BUCKET=telegram-files

STAGE=dev
